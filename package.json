{
  "name": "9dub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "9dub — adaptive NBA fantasy basketball 9-category draft assistant (local-first)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:demo": "tsx --tsconfig tsconfig.node.json scripts/data/generate-demo.ts",
    "data:build": "tsx --tsconfig tsconfig.node.json scripts/data/build-dataset.ts",
    "data:ingest": "tsx --tsconfig tsconfig.node.json scripts/data/ingest.ts",
    "data:schedule": "tsx --tsconfig tsconfig.node.json scripts/data/schedule.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.58.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
